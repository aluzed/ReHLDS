# Full server with many moving entities: clients32 plus 400 entities flying around
# the players (tools/bench/plugins/bench_entities.sma, through Metamod-R and AMX Mod X),
# so that each snapshot carries up to the 256 packet entities limit. Measures the
# snapshot encoding cost (epic 4).
MAP=de_dust2
TICRATE=1000
BOTS=0
HLTV=0
CLIENTS=32
CLIENT_CMDRATE=100
# The clients spawn and play, so that they see each other and the entities
CLIENTS_ALIVE=1
METAMOD=1
ENTITIES=400
WARMUP=25
DURATION=30
EXTRA_ARGS="+sv_maxupdaterate 100 +sv_maxrate 100000 +sv_minrate 25000"
