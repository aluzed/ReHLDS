# 8 protocol load clients: 4 in game, 4 that connect together 5 s into the
# measurement and download the same 6 MB map through the game connection (dlfile)
# while they sign on, its compressed copy deleted first: the server compresses it
# on the first request (MT-601).
MAP=de_dust2
TICRATE=1000
BOTS=0
HLTV=0
CLIENTS=8
WARMUP=20
DURATION=60
CLIENT_DOWNLOAD=maps/de_inferno.bsp
CLIENT_DOWNLOADERS=4
FINAL_COMMANDS="sv_filetransfer_async_stats"
