# Full server (clients32) under an A2S_INFO query flood from 4096 addresses,
# like a reflection or query flood on a public server. Run it with and without
# the network thread (BENCH_SERVER_ARGS="-netthread") and compare with clients32.
MAP=de_dust2
TICRATE=1000
BOTS=0
HLTV=0
CLIENTS=32
CLIENT_CMDRATE=100
WARMUP=25
DURATION=30
EXTRA_ARGS="+sv_maxupdaterate 100 +sv_maxrate 100000 +sv_minrate 25000"
FLOOD_KIND=a2s
FLOOD_PPS=50000
FLOOD_SOURCES=4096
