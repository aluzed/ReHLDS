# Short session for byte-exact replay checks (MT-004, tools/bench/replay.sh):
# 8 protocol load clients (moving, looking at the scoreboard) and 2 HLTV
# proxies, no bots (bot AI is not deterministic across runs, see
# docs/benchmarks/replay.md). Record it with BENCH_RECORD=1.
# The clients play (join, move, fire): player entities, weapon data and events
# are all in the snapshots.
MAP=de_dust2
TICRATE=1000
BOTS=0
HLTV=2
CLIENTS=8
CLIENT_CMDRATE=100
CLIENTS_ALIVE=1
WARMUP=15
DURATION=15
EXTRA_ARGS="+sv_maxupdaterate 100 +sv_maxrate 100000 +sv_minrate 25000"
