# 20 bots with the server log on, every shot logged (mp_logdetail 3), measured for
# 3 minutes: the log file's stdio buffer (8 KB) is written out several times during
# the window. With tools/bench/slowlog, measures log writes on a slow disk (MT-301).
MAP=de_dust2
TICRATE=1000
BOTS=20
HLTV=0
WARMUP=30
DURATION=180
EXTRA_ARGS="+log on +mp_logdetail 3 +sv_profile_frames 200000"
