# The replay scenario with a plugin hooking SV_EmitPings (tools/bench/plugins/
# bench_hooks.sma, through Metamod-R, AMX Mod X and ReAPI): with sv_parallel_send,
# the snapshots with pings are then encoded on the main thread.
MAP=de_dust2
TICRATE=1000
BOTS=0
HLTV=2
CLIENTS=8
CLIENT_CMDRATE=100
CLIENTS_ALIVE=1
METAMOD=1
SERVER_COMMANDS="bench_hook_pings"
WARMUP=15
DURATION=15
EXTRA_ARGS="+sv_maxupdaterate 100 +sv_maxrate 100000 +sv_minrate 25000"
FINAL_COMMANDS="bench_hook_stats"
